# The Vite development server proxies /api to this FastAPI server.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# For a separately hosted production API, set VITE_API_BASE_URL to its origin
# (for example https://api.example.org). Leave unset when using the /api proxy.
# VITE_API_BASE_URL=

# Optional: comma-separated browser origins allowed by FastAPI when hosting
# frontend and API on different origins.
# OPC_API_ALLOW_ORIGINS=https://relay.example.org

# AI4Free uses its Groq provider in .venv-ai4free. FastAPI loads this file as .env.
# Keep the key on the server only; never use a VITE_ prefix.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional absolute path when the AI4Free environment lives elsewhere.
# AI4FREE_PYTHON=/path/to/.venv-ai4free/bin/python
